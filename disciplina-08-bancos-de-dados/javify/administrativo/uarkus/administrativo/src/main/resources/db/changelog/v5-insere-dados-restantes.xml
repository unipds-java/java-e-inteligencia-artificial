<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Inclui os dados iniciais que trabalhamos nas aulas de fundamentos.

        Sao ~50 INSERTs com ids explicitos e UPDATEs de vinculo: em <insert> ou
        loadData isso viraria centenas de linhas de XML sem ganho nenhum. sqlFile
        mantem o SQL como SQL e o changeset como changeset.
    -->
    <changeSet id="5-dados-restantes" author="javify" labels="seed">
        <sqlFile path="db/changelog/v5-insere-dados-restantes.sql"
                 relativeToChangelogFile="false"
                 splitStatements="true"
                 endDelimiter=";"
                 stripComments="true"
                 encoding="UTF-8"/>
        <rollback>
            DELETE FROM cartao_credito;
            UPDATE usuario SET assinatura_id = NULL;
            DELETE FROM assinatura;
            DELETE FROM usuario_telefone;
            DELETE FROM usuario;
            DELETE FROM endereco;
            DELETE FROM plano WHERE nome IN ('Family','Student','Duo');
        </rollback>
    </changeSet>

</databaseChangeLog>
